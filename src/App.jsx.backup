                          >
                            Gosavi
                          </GradientText>
                        </h1>
                      </BlurFade>

                      <BlurFade delay={0.4} inView>
                        <p className="text-xl sm:text-2xl text-white/60 max-w-xl leading-relaxed">
                          <span className="text-white font-semibold">AI/ML Engineer</span> crafting intelligent systems 
                          that push the boundaries of what's possible.
                        </p>
                      </BlurFade>
                    </div>

                    <BlurFade delay={0.5} inView>
                      <div className="flex flex-wrap gap-4">
                        <MagneticButton
                          strength={30}
                          className="magnetic-target"
                          onClick={() => scrollTo('#projects')}
                        >
                          <GlowButton className="px-8 py-4 text-base">
                            View My Work <FaArrowRight className="ml-2" />
                          </GlowButton>
                        </MagneticButton>

                        <MagneticButton
                          strength={30}
                          className="magnetic-target"
                          onClick={() => scrollTo('#contact')}
                        >
                          <OutlineButton className="px-8 py-4 text-base">
                            Get In Touch
                          </OutlineButton>
                        </MagneticButton>
                      </div>
                    </BlurFade>

                    <BlurFade delay={0.6} inView>
                      <div className="flex items-center gap-6 pt-4">
                        <MagneticWrapper strength={50}>
                          <a 
                            href="https://github.com/kg290" 
                            target="_blank" 
                            rel="noopener noreferrer"
                            className="text-white/50 hover:text-white transition-colors p-2"
                          >
                            <FaGithub size={24} />
                          </a>
                        </MagneticWrapper>
                        <MagneticWrapper strength={50}>
                          <a 
                            href="https://linkedin.com/in/karnajeet-gosavi-0797452bb" 
                            target="_blank" 
                            rel="noopener noreferrer"
                            className="text-white/50 hover:text-white transition-colors p-2"
                          >
                            <FaLinkedin size={24} />
                          </a>
                        </MagneticWrapper>
                        <MagneticWrapper strength={50}>
                          <a 
                            href="mailto:karnajeet.gosavi23@vit.edu"
                            className="text-white/50 hover:text-white transition-colors p-2"
                          >
                            <FaEnvelope size={24} />
                          </a>
                        </MagneticWrapper>
                      </div>
