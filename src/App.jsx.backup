                            </SpotlightCard>
                          </div>
                        </div>
                      </StaggerItem>
                    ))}
                  </StaggerContainer>
                </div>
              </div>
            </section>

            {/* ═══════════════════════════════════════════════════════════
                                      SKILLS SECTION
                ═══════════════════════════════════════════════════════════ */}
            <section 
              id="skills" 
              className="relative py-32 overflow-hidden"
              ref={(el) => (sectionsRef.current[3] = el)}
            >
              <div className="absolute inset-0 z-0">
                <GridPattern className="opacity-10" width={60} height={60} />
              </div>

              <div className="relative z-10 max-w-7xl mx-auto px-6 lg:px-8">
                <BlurFade delay={0.1} inView>
                  <div className="flex items-center gap-4 mb-4">
                    <span className="text-primary font-mono text-sm">03.</span>
                    <h2 className="text-4xl sm:text-5xl font-bold text-white">Tech Stack</h2>
                    <div className="flex-1 h-px bg-gradient-to-r from-white/20 to-transparent ml-4" />
                  </div>
                  <p className="text-white/50 max-w-2xl mt-4">
                    Technologies I work with to bring ideas to life.
                  </p>
                </BlurFade>

                {/* Marquee Skills */}
                <div className="mt-16 space-y-4">
                  <LogoLoop
                    items={SKILLS.slice(0, 8).map((s) => (
                      <div key={s.name} className="flex items-center gap-3 px-5 py-3 rounded-xl bg-white/5 border border-white/10 backdrop-blur-sm">
                        <span className="text-primary">{s.icon}</span>
                        <span className="text-white font-medium">{s.name}</span>
                      </div>
                    ))}
                    speed={25}
                    direction="left"
                  />
                  <LogoLoop
                    items={SKILLS.slice(8).map((s) => (
                      <div key={s.name} className="flex items-center gap-3 px-5 py-3 rounded-xl bg-white/5 border border-white/10 backdrop-blur-sm">
                        <span className="text-secondary">{s.icon}</span>
                        <span className="text-white font-medium">{s.name}</span>
                      </div>
                    ))}
                    speed={20}
                    direction="right"
                  />
                </div>

                {/* Skill Categories */}
                <div className="grid md:grid-cols-3 gap-6 mt-16">
                  {SKILL_CATEGORIES.map((cat, i) => (
                    <BlurFade key={cat.title} delay={0.2 + i * 0.1} inView>
                      <PixelCard variant={cat.variant} gap={5} speed={35} className="h-full min-h-[320px] w-full">
                        <div className="relative z-10 p-8 h-full flex flex-col">
                          <div 
                            className="w-14 h-14 rounded-2xl flex items-center justify-center mb-6"
                            style={{ backgroundColor: `${cat.color}20`, color: cat.color }}
                          >
                            {cat.icon}
                          </div>
                          <h3 className="text-xl font-bold text-white mb-4">{cat.title}</h3>
                          <div className="flex flex-wrap gap-2">
                            {cat.items.map((item) => (
                              <span 
                                key={item} 
                                className="px-3 py-1.5 text-sm rounded-lg bg-white/5 border border-white/10 text-white/70 hover:text-white hover:border-white/20 transition-colors"
                              >
                                {item}
                              </span>
                            ))}
                          </div>
                        </div>
                      </PixelCard>
                    </BlurFade>
                  ))}
                </div>
              </div>
            </section>

            {/* ═══════════════════════════════════════════════════════════
                                     PROJECTS SECTION
                ═══════════════════════════════════════════════════════════ */}
            <section 
              id="projects" 
              className="relative py-32 overflow-hidden"
              ref={(el) => (sectionsRef.current[4] = el)}
            >
              <div className="relative z-10 max-w-7xl mx-auto px-6 lg:px-8">
                <BlurFade delay={0.1} inView>
                  <div className="flex items-center gap-4 mb-4">
                    <span className="text-primary font-mono text-sm">04.</span>
                    <h2 className="text-4xl sm:text-5xl font-bold text-white">Featured Projects</h2>
                    <div className="flex-1 h-px bg-gradient-to-r from-white/20 to-transparent ml-4" />
                  </div>
                  <p className="text-white/50 max-w-2xl mt-4">
                    A selection of projects that showcase my skills and passion.
                  </p>
                </BlurFade>

                {/* Featured Projects */}
                <div className="mt-16 space-y-24">
                  {PROJECTS.filter(p => p.featured).map((project, i) => (
                    <BlurFade key={project.title} delay={0.2 + i * 0.1} inView>
                      <div className={cn(
                        "grid lg:grid-cols-2 gap-8 lg:gap-16 items-center",
                        i % 2 === 1 ? "lg:direction-rtl" : ""
                      )}>
                        {/* Project Image */}
                        <div className="relative group">
                          <div className="absolute -inset-4 bg-gradient-to-r from-primary/20 to-secondary/20 rounded-2xl blur-xl opacity-0 group-hover:opacity-100 transition-opacity duration-500" />
                          <div className="relative aspect-video rounded-xl overflow-hidden border border-white/10 bg-card">
                            {project.image ? (
                              <img 
                                src={project.image} 
                                alt={project.title}
                                className="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                              />
                            ) : (
                              <div className="w-full h-full flex items-center justify-center bg-gradient-to-br from-primary/10 to-secondary/10">
                                <FaCode className="text-6xl text-white/20" />
                              </div>
                            )}
                            <div className="absolute inset-0 bg-gradient-to-t from-background/80 to-transparent" />
                          </div>
                        </div>

                        {/* Project Info */}
                        <div className={cn("space-y-6", i % 2 === 1 ? "lg:text-right" : "")}>
                          <div>
                            <span className="text-primary font-mono text-sm">Featured Project</span>
                            <h3 className="text-2xl sm:text-3xl font-bold text-white mt-2">{project.title}</h3>
                          </div>
                          
                          <SpotlightCard className="p-6 spotlight-card" spotlightColor="rgba(99, 102, 241, 0.08)">
                            <p className="text-white/70 leading-relaxed">{project.description}</p>
                          </SpotlightCard>

                          <div className={cn(
                            "flex flex-wrap gap-3",
                            i % 2 === 1 ? "lg:justify-end" : ""
                          )}>
                            {project.tech.map((t) => (
                              <span key={t} className="px-4 py-2 text-sm rounded-lg bg-white/5 border border-white/10 text-primary font-mono">
                                {t}
                              </span>
                            ))}
                          </div>

                          <div className={cn(
                            "flex items-center gap-4",
                            i % 2 === 1 ? "lg:justify-end" : ""
                          )}>
                            <a 
                              href={project.link} 
                              target="_blank" 
                              rel="noopener noreferrer"
                              className="flex items-center gap-2 text-white hover:text-primary transition-colors"
                            >
                              <FaGithub size={20} />
                              <span>View Code</span>
                            </a>
                            <a 
                              href={project.link} 
                              target="_blank" 
                              rel="noopener noreferrer"
                              className="flex items-center gap-2 text-white hover:text-primary transition-colors"
                            >
                              <FaExternalLinkAlt size={16} />
                              <span>Live Demo</span>
                            </a>
                          </div>
                        </div>
                      </div>
                    </BlurFade>
                  ))}
                </div>

                {/* Other Projects Grid */}
                <div className="mt-24">
                  <BlurFade delay={0.1} inView>
                    <h3 className="text-2xl font-bold text-white mb-8">Other Noteworthy Projects</h3>
                  </BlurFade>
                  
                  <StaggerContainer staggerDelay={0.1} className="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
                    {PROJECTS.filter(p => !p.featured).map((project) => (
                      <StaggerItem key={project.title}>
                        <a 
                          href={project.link} 
                          target="_blank" 
                          rel="noopener noreferrer"
                          className="block h-full project-link"
                        >
                          <SpotlightCard className="h-full p-6 spotlight-card group" spotlightColor="rgba(168, 85, 247, 0.1)">
                            <div className="flex flex-col h-full">
                              <div className="flex items-center justify-between mb-4">
                                <div className="w-12 h-12 rounded-xl bg-primary/10 flex items-center justify-center text-primary">
                                  <FaCode size={20} />
                                </div>
                                <FaExternalLinkAlt className="text-white/30 group-hover:text-primary transition-colors" />
                              </div>
                              <h4 className="text-lg font-bold text-white mb-2 group-hover:text-primary transition-colors">
                                {project.title}
                              </h4>
                              <p className="text-white/60 text-sm flex-1 mb-4">{project.description}</p>
                              <div className="flex flex-wrap gap-2">
                                {project.tech.map((t) => (
                                  <span key={t} className="text-xs text-white/50 font-mono">{t}</span>
                                ))}
                              </div>
                            </div>
                          </SpotlightCard>
                        </a>
                      </StaggerItem>
                    ))}
                  </StaggerContainer>
                </div>

                {/* View All Projects Button */}
                <BlurFade delay={0.3} inView>
                  <div className="flex justify-center mt-16">
                    <MagneticButton strength={25} className="magnetic-target">
                      <a 
                        href="https://github.com/kg290" 
                        target="_blank" 
                        rel="noopener noreferrer"
                      >
                        <OutlineButton className="px-8 py-4">
                          View All Projects on GitHub <FaGithub className="ml-2" />
                        </OutlineButton>
                      </a>
                    </MagneticButton>
                  </div>
                </BlurFade>
              </div>
            </section>

            {/* ═══════════════════════════════════════════════════════════
                                     TERMINAL EASTER EGG
                ═══════════════════════════════════════════════════════════ */}
            <section className="relative py-16 overflow-hidden">
              <div className="relative z-10 max-w-7xl mx-auto px-6 lg:px-8">
                <BlurFade delay={0.1} inView>
                  <div className="flex items-center justify-center gap-4 mb-8">
                    <FaTerminal className="text-primary" />
                    <span className="text-white/50 text-sm">Interactive Terminal — Try typing "help"</span>
                  </div>
                </BlurFade>
                <BlurFade delay={0.2} inView>
                  <Terminal />
                </BlurFade>
              </div>
            </section>

            {/* ═══════════════════════════════════════════════════════════
                                      CONTACT SECTION
                ═══════════════════════════════════════════════════════════ */}
            <section 
              id="contact" 
              className="relative py-32 overflow-hidden"
              ref={(el) => (sectionsRef.current[5] = el)}
            >
              <div className="absolute inset-0 z-0">
                <RetroGrid className="opacity-20" angle={75} />
              </div>

              <div className="relative z-10 max-w-4xl mx-auto px-6 lg:px-8 text-center">
                <BlurFade delay={0.1} inView>
                  <span className="text-primary font-mono text-sm">05. What's Next?</span>
                  <h2 className="text-4xl sm:text-5xl lg:text-6xl font-bold text-white mt-4 mb-6">
                    Let's Build Something<br />
                    <GradientText colors={['#6366f1', '#a855f7', '#ec4899']}>
                      Amazing Together
                    </GradientText>
                  </h2>
                  <p className="text-white/60 text-lg max-w-2xl mx-auto mb-12">
                    I'm currently looking for new opportunities and my inbox is always open. 
                    Whether you have a question, want to collaborate, or just want to say hi — 
                    I'll try my best to get back to you!
                  </p>
                </BlurFade>

                <BlurFade delay={0.2} inView>
                  <div className="flex flex-wrap justify-center gap-6 mb-16">
                    <MagneticButton strength={30} className="magnetic-target">
                      <a href="mailto:karnajeet.gosavi23@vit.edu">
                        <GlowButton className="px-10 py-5 text-lg">
                          <FaEnvelope className="mr-3" /> Say Hello
                        </GlowButton>
                      </a>
                    </MagneticButton>
                  </div>
                </BlurFade>

                <BlurFade delay={0.3} inView>
                  <div className="flex justify-center gap-8">
                    {[
                      { icon: <FaGithub size={24} />, link: 'https://github.com/kg290', label: 'GitHub' },
                      { icon: <FaLinkedin size={24} />, link: 'https://linkedin.com/in/karnajeet-gosavi-0797452bb', label: 'LinkedIn' },
                      { icon: <FaEnvelope size={24} />, link: 'mailto:karnajeet.gosavi23@vit.edu', label: 'Email' },
                    ].map((social) => (
                      <MagneticWrapper key={social.label} strength={60}>
                        <a
                          href={social.link}
                          target="_blank"
                          rel="noopener noreferrer"
                          className="group flex flex-col items-center gap-2"
                        >
                          <div className="w-14 h-14 rounded-full bg-white/5 border border-white/10 flex items-center justify-center text-white/50 group-hover:text-primary group-hover:border-primary/50 transition-all duration-300">
                            {social.icon}
                          </div>
                          <span className="text-xs text-white/30 group-hover:text-white/50 transition-colors">
                            {social.label}
                          </span>
                        </a>
                      </MagneticWrapper>
                    ))}
                  </div>
                </BlurFade>
              </div>
            </section>

            {/* ══════════════════ FOOTER ══════════════════ */}
            <footer className="relative z-10 py-8 border-t border-white/5">
              <div className="max-w-7xl mx-auto px-6 lg:px-8">
                <div className="flex flex-col md:flex-row items-center justify-between gap-4">
                  <div className="flex items-center gap-2 text-white/30 text-sm">
                    <span>Designed & Built by</span>
                    <span className="text-primary font-semibold">Karnajeet Gosavi</span>
                  </div>
                  <div className="text-white/30 text-sm">
                    © {new Date().getFullYear()} All rights reserved.
                  </div>
                </div>
              </div>
            </footer>
          </motion.div>
        )}
      </AnimatePresence>
    </>
  );
}

export default App;
