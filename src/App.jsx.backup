                      <div className="absolute -inset-20 bg-gradient-to-r from-primary/20 via-secondary/20 to-primary/20 rounded-full blur-3xl opacity-30 animate-pulse-slow" />
                      <Lanyard 
                        name="Karnajeet Gosavi" 
                        handle="@kg290" 
                        title="AI/ML Engineer" 
                        avatarUrl={AVATAR_URL} 
                      />
                    </div>
                  </BlurFade>
                </div>

                {/* Scroll Indicator */}
                <motion.div 
                  className="absolute bottom-10 left-1/2 -translate-x-1/2"
                  initial={{ opacity: 0, y: -10 }}
                  animate={{ opacity: 1, y: 0 }}
                  transition={{ delay: 1, duration: 0.5 }}
                >
                  <motion.div
                    animate={{ y: [0, 8, 0] }}
                    transition={{ duration: 1.5, repeat: Infinity, ease: "easeInOut" }}
                    className="flex flex-col items-center gap-2 text-white/30"
                  >
                    <span className="text-xs uppercase tracking-widest">Scroll</span>
                    <div className="w-5 h-8 rounded-full border-2 border-white/20 flex justify-center pt-2">
                      <motion.div
                        animate={{ y: [0, 8, 0], opacity: [1, 0.3, 1] }}
                        transition={{ duration: 1.5, repeat: Infinity, ease: "easeInOut" }}
                        className="w-1 h-1 rounded-full bg-white/50"
                      />
                    </div>
                  </motion.div>
                </motion.div>
              </div>
            </section>

            {/* ═══════════════════════════════════════════════════════════
                                      ABOUT SECTION
                ═══════════════════════════════════════════════════════════ */}
            <section 
              id="about" 
              className="relative py-32 overflow-hidden"
              ref={(el) => (sectionsRef.current[1] = el)}
            >
              <div className="absolute inset-0 z-0">
                <DotPattern className="opacity-20" />
              </div>

              <div className="relative z-10 max-w-7xl mx-auto px-6 lg:px-8">
                <BlurFade delay={0.1} inView>
                  <div className="flex items-center gap-4 mb-4">
                    <span className="text-primary font-mono text-sm">01.</span>
                    <h2 className="text-4xl sm:text-5xl font-bold text-white">About Me</h2>
                    <div className="flex-1 h-px bg-gradient-to-r from-white/20 to-transparent ml-4" />
                  </div>
                </BlurFade>

                <div className="grid lg:grid-cols-2 gap-16 mt-16">
                  {/* Profile Card */}
                  <BlurFade delay={0.2} inView>
                    <div className="flex flex-col items-center lg:items-start gap-8">
                      <ProfileCard
                        name="Karnajeet Gosavi"
                        handle="@kg290"
                        title="AI/ML Engineer • India"
                        avatarUrl={AVATAR_URL}
                        status="Open to opportunities"
                        showUserInfo
                        enableTilt
                        behindGlowEnabled
                        behindGlowColor="rgba(99, 102, 241, 0.35)"
                      />
                      
                      {/* Stats Grid */}
                      <div className="grid grid-cols-2 gap-4 w-full max-w-md">
                        {STATS.map((stat, i) => (
                          <SpotlightCard 
                            key={i} 
                            className="p-6 text-center spotlight-card"
                            spotlightColor="rgba(99, 102, 241, 0.1)"
                          >
                            <div className="text-3xl font-bold text-white">
                              <NumberCounter value={stat.value} suffix={stat.suffix} delay={0.3 + i * 0.1} />
                            </div>
                            <div className="text-xs text-white/50 mt-1 uppercase tracking-wider">{stat.label}</div>
                          </SpotlightCard>
                        ))}
                      </div>
                    </div>
                  </BlurFade>

                  {/* About Content */}
                  <BlurFade delay={0.3} inView>
                    <div className="space-y-6">
                      <div className="relative">
                        <SpotlightCard className="p-8 spotlight-card" spotlightColor="rgba(168, 85, 247, 0.1)">
                          <BorderBeam size={200} duration={12} />
                          <div className="space-y-5 text-white/70 leading-relaxed">
                            <p>
                              I'm a passionate <span className="text-white font-semibold">AI/ML engineer</span> based in India 
                              with a deep fascination for building intelligent systems that solve real-world problems. Currently 
                              pursuing my education at <span className="text-primary">VIT</span> while working on cutting-edge 
                              machine learning projects.
                            </p>
                            <p>
                              My expertise spans <span className="text-secondary">deep learning</span>, natural language processing, 
                              computer vision, and full-stack development. I love combining AI capabilities with modern web 
                              technologies to create impactful applications that make a difference.
                            </p>
                            <p>
                              When I'm not training models or debugging neural networks, you'll find me contributing to 
                              open-source projects, exploring new technologies, and sharing knowledge with the developer community.
                            </p>
                          </div>
                        </SpotlightCard>
                      </div>

                      {/* Quick Facts */}
                      <div className="grid grid-cols-2 gap-4">
                        <div className="flex items-center gap-3 p-4 rounded-lg bg-white/5 border border-white/10">
                          <div className="w-10 h-10 rounded-lg bg-primary/20 flex items-center justify-center text-primary">
                            <FaBrain size={18} />
                          </div>
                          <div>
                            <div className="text-xs text-white/50">Focus</div>
                            <div className="text-sm text-white font-medium">AI/ML Research</div>
                          </div>
                        </div>
                        <div className="flex items-center gap-3 p-4 rounded-lg bg-white/5 border border-white/10">
                          <div className="w-10 h-10 rounded-lg bg-secondary/20 flex items-center justify-center text-secondary">
                            <FaCode size={18} />
                          </div>
                          <div>
                            <div className="text-xs text-white/50">Specialty</div>
                            <div className="text-sm text-white font-medium">Full Stack Dev</div>
                          </div>
                        </div>
                      </div>

                      {/* Resume Button */}
                      <MagneticButton strength={20} className="magnetic-target">
                        <ShinyButton className="w-full justify-center gap-2">
                          <FaDownload /> Download Resume
                        </ShinyButton>
                      </MagneticButton>
                    </div>
                  </BlurFade>
                </div>
              </div>
            </section>

            {/* ═══════════════════════════════════════════════════════════
                                    EXPERIENCE SECTION
                ═══════════════════════════════════════════════════════════ */}
            <section 
              id="experience" 
              className="relative py-32 overflow-hidden"
              ref={(el) => (sectionsRef.current[2] = el)}
            >
              <div className="relative z-10 max-w-7xl mx-auto px-6 lg:px-8">
                <BlurFade delay={0.1} inView>
                  <div className="flex items-center gap-4 mb-4">
                    <span className="text-primary font-mono text-sm">02.</span>
                    <h2 className="text-4xl sm:text-5xl font-bold text-white">Experience</h2>
                    <div className="flex-1 h-px bg-gradient-to-r from-white/20 to-transparent ml-4" />
