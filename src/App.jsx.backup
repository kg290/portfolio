const STATS = [
  { value: 20, suffix: '+', label: 'Projects Completed' },
  { value: 15, suffix: '+', label: 'Technologies Used' },
  { value: 500, suffix: '+', label: 'Commits This Year' },
  { value: 3, suffix: '+', label: 'Years Experience' },
];

function App() {
  const [activeSection, setActiveSection] = useState(0);
  const [isLoaded, setIsLoaded] = useState(false);
  const [showTerminal, setShowTerminal] = useState(false);
  const sectionsRef = useRef([]);

  useEffect(() => {
    const secs = sectionsRef.current.filter(Boolean);
    if (!secs.length) return;
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const idx = sectionsRef.current.indexOf(entry.target);
            if (idx !== -1) setActiveSection(idx);
          }
        });
      },
      { threshold: 0.3 }
    );
    secs.forEach((s) => observer.observe(s));
    return () => observer.disconnect();
  }, [isLoaded]);

  const scrollTo = (id) => {
    document.querySelector(id)?.scrollIntoView({ behavior: 'smooth' });
  };

  return (
    <>
      <Preloader onComplete={() => setIsLoaded(true)} minDuration={2500} />
      
      <AnimatePresence>
        {isLoaded && (
          <motion.div
            initial={{ opacity: 0 }}
            animate={{ opacity: 1 }}
            transition={{ duration: 0.5 }}
            className="app"
          >
            {/* ══════════════════ BACKGROUND LAYERS ══════════════════ */}
            <div className="fixed inset-0 z-0">
              <AntiGravity
                count={200}
                magnetRadius={15}
                ringRadius={12}
                waveSpeed={0.3}
                waveAmplitude={1.2}
                particleSize={1.2}
                lerpSpeed={0.04}
                color="#6366f1"
                autoAnimate={true}
                particleVariance={1.2}
                rotationSpeed={0.15}
                depthFactor={1.2}
                pulseSpeed={2.5}
                fieldStrength={8}
                particleShape="capsule"
              />
            </div>
            
            <div className="fixed inset-0 z-0 opacity-20 pointer-events-none">
              <Waves
                lineColor="rgba(99, 102, 241, 0.08)"
                backgroundColor="transparent"
                waveSpeedX={0.008}
                waveSpeedY={0.004}
                waveAmpX={35}
                waveAmpY={15}
              />
            </div>

            {/* ══════════════════ CURSOR ══════════════════ */}
            <TargetCursor targetSelector="button, a, .cursor-target, .cta-btn, .nav-card-link, .sm-panel-item, .star-border-container, .pixel-card, .glare-hover, .project-link, .contact-anchor, .menu__item-link, .magnetic-target, .spotlight-card" />

            {/* ══════════════════ NAVIGATION ══════════════════ */}
            <StaggeredMenu
              items={NAV_ITEMS.map((item) => ({ label: item.label, link: item.link }))}
              socialItems={[
                { label: 'GitHub', link: 'https://github.com/kg290' },
                { label: 'LinkedIn', link: 'https://linkedin.com/in/karnajeet-gosavi-0797452bb' },
                { label: 'Email', link: 'mailto:karnajeet.gosavi23@vit.edu' },
              ]}
              colors={['#030303', '#6366f1']}
              accentColor="#6366f1"
              menuButtonColor="#fff"
              openMenuButtonColor="#fff"
              isFixed
              closeOnClickAway
            />

            <GooeyNav
              items={NAV_ITEMS.map((item) => ({ label: item.label, href: item.link }))}
              initialActiveIndex={activeSection}
            />

            {/* ═══════════════════════════════════════════════════════════
                                      HERO SECTION
                ═══════════════════════════════════════════════════════════ */}
            <section 
              id="hero" 
              className="relative min-h-screen flex items-center justify-center overflow-hidden"
              ref={(el) => (sectionsRef.current[0] = el)}
            >
              <div className="absolute inset-0 z-0">
                <RetroGrid className="opacity-30" />
              </div>
              
              <Meteors number={15} className="z-0" />

              <div className="relative z-10 max-w-7xl mx-auto px-6 lg:px-8 w-full">
                <div className="grid lg:grid-cols-2 gap-12 lg:gap-20 items-center">
                  {/* Left Content */}
                  <div className="space-y-8">
                    <BlurFade delay={0.1} inView>
                      <div className="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-primary/20 bg-primary/5 text-sm text-primary">
                        <span className="relative flex h-2 w-2">
                          <span className="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary opacity-75"></span>
                          <span className="relative inline-flex rounded-full h-2 w-2 bg-primary"></span>
                        </span>
                        Available for opportunities
                      </div>
                    </BlurFade>

                    <div className="space-y-4">
                      <BlurFade delay={0.2} inView>
                        <p className="text-lg text-muted-foreground">Hi, I'm</p>
                      </BlurFade>
                      
                      <BlurFade delay={0.3} inView>
                        <h1 className="text-5xl sm:text-6xl lg:text-7xl xl:text-8xl font-black tracking-tight">
                          <TextReveal className="text-white">Karnajeet</TextReveal>
                          <br />
                          <GradientText 
                            className="text-5xl sm:text-6xl lg:text-7xl xl:text-8xl font-black"
                            colors={['#6366f1', '#a855f7', '#ec4899', '#6366f1']}
